          },
          "expr": "topk(20, sum by (ip) (count_over_time({job=\"nginx-access\"} | pattern `<ip> - <_> [<_>] \"<_>\" <_> <_> \"<_>\" \"<_>\"` | __error__=\"\" [$__range])))",
          "queryType": "instant",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value #A",
                "desc": true
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "ip": "IP",
              "Value #A": "건수"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "건수"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "User-Agent 상위 (기간)",
      "datasource": {
        "type": "loki",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
