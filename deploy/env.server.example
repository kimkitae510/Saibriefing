# 서버의 /opt/3am/.env 로 올린다. systemd 유닛이 EnvironmentFile로 읽는다.
#   sudo chown threeam:threeam /opt/3am/.env
#   sudo chmod 600 /opt/3am/.env      ← DB 비밀번호와 JWT 시크릿이 들어 있다
#
# 루트의 .env.example 과 항목이 같다. 여기엔 운영에서 반드시 채워야 하는 것만 남겼다.

# ── 데이터베이스 ──────────────────────────────────────────
# HeatWave DB의 프라이빗 IP. 콘솔 DB 상세 화면에 나온다(10.0.1.x).
DB_HOST=
DB_PORT=3306
DB_NAME=threeam
DB_USERNAME=
DB_PASSWORD=

# ── 인증 ────────────────────────────────────────────────
# 256비트 이상 랜덤. 서버에서: openssl rand -base64 48
JWT_SECRET=

# ── LLM ─────────────────────────────────────────────────
LLM_PROVIDER=vertex
LLM_MODEL=
LLM_ASSESSMENT_MODEL=
GCP_PROJECT_ID=
GCP_LOCATION=global
# 서비스 계정 키 JSON의 서버 경로. 저장소 밖에 두고 권한 600으로 잠근다.
GOOGLE_APPLICATION_CREDENTIALS=/opt/3am/gcp-key.json

# ── LLM: 판독 프로바이더 분기 (비우면 위 LLM_PROVIDER 경로로 판독) ──
# anthropic | openai
LLM_READING_PROVIDER=
ANTHROPIC_API_KEY=
LLM_READING_MODEL=claude-sonnet-5
OPENAI_API_KEY=
# 판독용 OpenAI 모델. 기본값 없음 — 비어 있으면 기동 시 호출 전에 막고 이유를 로그로 남긴다
LLM_OPENAI_READING_MODEL=
# 결정, 판정 호출 전용 모델(선택). 비우면 판독 모델
LLM_OPENAI_DECISION_MODEL=
LLM_OPENAI_VERDICT_MODEL=
# 탐색 채팅(답변 + 목표 판정) 전용 모델. 비우면 채팅은 LLM_PROVIDER 경로로 돈다
LLM_OPENAI_CHAT_MODEL=
LLM_OPENAI_TIMEOUT_SECONDS=240
# usage.chat-lock-ttl-seconds(110)의 절반보다 작아야 한다 — 판정과 답변이 순차라 두 번 든다
LLM_OPENAI_CHAT_TIMEOUT_SECONDS=50
LLM_OPENAI_REASONING_EFFORT=low
# 채팅 전용 추론 강도. 판독을 올려도 채팅은 low에 둔다
LLM_OPENAI_CHAT_REASONING_EFFORT=low
# 탐색 채팅 답변을 Claude로(예: claude-haiku-5-5). 채우면 위 OpenAI 채팅 모델보다 먼저 탄다.
# 실패나 거절이면 OpenAI 채팅 모델, 그것도 없으면 LLM_PROVIDER로 1회 넘긴다. 목표 판정은 이 경로를 안 탄다
LLM_ANTHROPIC_CHAT_MODEL=
# Claude 채팅 추론 세기(low | medium | high). Haiku 5.5 실측은 medium
LLM_ANTHROPIC_CHAT_EFFORT=medium
# 첫 응답(헤더)까지의 상한. 실패 시 넘겨받는 경로의 상한과 합쳐도 채팅 잠금(110초)보다 짧아야 한다
LLM_ANTHROPIC_CHAT_TIMEOUT_SECONDS=30
# 100만 토큰당 USD. 비우면 모델 단가표(코드)로 계산하고, 표에 없으면 토큰 수만 남긴다
LLM_OPENAI_PRICE_INPUT=
LLM_OPENAI_PRICE_CACHED_INPUT=
LLM_OPENAI_PRICE_OUTPUT=
LLM_USD_KRW=1450

# ── 프롬프트, 사례 자산 (gitignore라 서버에 직접 올린다) ────────
# WorkingDirectory(/opt/3am) 기준 상대경로로 읽는다.
MATCH_CASE_FILE=사례데이터.json

# ── 결제 ────────────────────────────────────────────────
# 포트원 심사가 끝나기 전까지는 mock으로 둔다.
PAYMENT_PROVIDER=mock
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ── 메일 ────────────────────────────────────────────────
MAIL_PROVIDER=mock
MAIL_USERNAME=
MAIL_PASSWORD=

# ── 소셜 로그인 ──────────────────────────────────────────
OAUTH_PROVIDER=real
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── CORS ────────────────────────────────────────────────
# 프론트를 같은 서버에서 서빙하므로 동일 출처지만, 명시해 두면 안전하다.
CORS_ALLOWED_ORIGINS=https://saibriefing.com
