// Grafana Alloy 설정 — 앱 지표와 호스트 지표를 1분 주기로 긁어 Grafana Cloud로 민다.
//
// 설치:
//   sudo cp deploy/alloy/config.alloy /etc/alloy/config.alloy
//   토큰은 /etc/alloy/token (권한 600, 소유 alloy) — 파일 내용이 토큰 문자열 하나다.
//   nginx 로그를 읽으려면 한 번만: sudo usermod -aG adm alloy
//   sudo systemctl restart alloy
//
// 토큰은 Grafana Cloud 포털의 Access Policy(metrics:write 권한)에서 발급한다.
// 설정 파일엔 토큰을 직접 넣지 않는다 — 이 파일은 저장소에 커밋되기 때문이다.

// ── 앱 지표: 스프링 액추에이터 (management 포트, 로컬 전용) ──────────────
prometheus.scrape "app" {
  targets = [{
    __address__ = "127.0.0.1:9090",
    job         = "3am-app",
  }]
  metrics_path    = "/actuator/prometheus"
  scrape_interval = "60s"
  forward_to      = [prometheus.relabel.trim.receiver]
}

// ── 호스트 지표: CPU, 메모리, 디스크, 네트워크 (node_exporter 내장판) ────
// 컬렉터를 필요한 것만 켠다 — 기본값 전부를 켜면 시리즈가 수백 개 늘어난다.
prometheus.exporter.unix "host" {
  // sockstat/netstat: TCP 연결 상태(established, TIME_WAIT, 재전송) — 커넥션 계층 진단용.
  // vmstat: oom_kill 카운터. 스왑이 없어 OOM이면 자바가 죽고 5초 뒤 되살아나 다운 알림으로는 안 잡힌다.
  // timex: 시계 동기화 상태. 시계가 틀어지면 JWT 만료, 결제 서명, 로그 시각이 조용히 어긋난다.
  set_collectors = ["cpu", "meminfo", "filesystem", "diskstats", "netdev", "loadavg", "uname", "sockstat", "netstat", "vmstat", "timex"]

  filesystem {
    // 가상/임시 마운트는 디스크 경보에 의미가 없다.
    fs_types_exclude = "^(tmpfs|devtmpfs|overlay|squashfs|proc|sysfs|cgroup2?)$"
  }
  netdev {
    // 루프백과 가상 인터페이스 제외.
    device_exclude = "^(lo|veth.*|docker.*)$"
  }
}

prometheus.scrape "host" {
  targets         = prometheus.exporter.unix.host.targets
  scrape_interval = "60s"
  forward_to      = [prometheus.relabel.trim.receiver]
}

// ── 가짓수 절감: 안 보는 지표는 전송 전에 버린다 ─────────────────────────
prometheus.relabel "trim" {
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]

  // JVM 버퍼풀 세부, 클래스 로딩 수는 대시보드나 경보 어디에도 안 쓴다.
  rule {
    source_labels = ["__name__"]
    regex         = "(jvm_buffer_.*|jvm_classes_.*)"
    action        = "drop"
  }
}

// ── DB 내부 지표: MySQL 원격 수집 (읽기 전용 모니터링 계정) ──────────────
// 접속 문자열(계정:비밀번호@주소)은 서버 파일로만 관리 — 커밋 금지.
// 파일이 없으면 Alloy 기동이 실패하니, 이 설정을 올릴 때 반드시 함께 만든다.
local.file "mysql_dsn" {
  filename  = "/etc/alloy/mysql_dsn"
  is_secret = true
}

prometheus.exporter.mysql "db" {
  data_source_name = local.file.mysql_dsn.content
}

prometheus.scrape "db" {
  targets         = prometheus.exporter.mysql.db.targets
  scrape_interval = "60s"
  forward_to      = [prometheus.relabel.trim.receiver]
}

// ── 앱 로그: INFO 이상을 로키로, 사연 문장이 실리는 두 줄만 뺀다 ───────────
// 개인정보는 레벨이 아니라 내용으로 막는다. INFO 중 사연 본문이 찍히는 건
// 판독 근거 기록(LLM이 쓴 근거 전문)과 검색 질의(사연에서 뽑은 검색어) 둘뿐이라
// 그 덩어리만 버린다. 서버 파일에는 그대로 남는다.
local.file_match "app_logs" {
  path_targets = [{ __path__ = "/opt/3am/logs/3am.log", job = "3am-app-logs" }]
}

loki.source.file "app" {
  targets    = local.file_match.app_logs.targets
  forward_to = [loki.process.app.receiver]
}

loki.process "app" {
  forward_to = [loki.write.grafana_cloud.receiver]

  // 스택트레이스와 여러 줄 메시지(레벨 표기 없는 후속 줄)가 본줄과 한 덩어리로 묶이게 먼저 합친다.
  // 아래 drop은 덩어리 단위로 걸리므로 근거 기록의 후속 줄까지 같이 버려진다.
  stage.multiline {
    firstline = "^\\d{4}-\\d{2}-\\d{2} "
  }
  stage.drop {
    expression = "\\] (DEBUG|TRACE) "
  }
  stage.drop {
    expression = "판독 근거 기록:|검색 질의:"
  }
  // 레벨만 라벨로 올린다 — 대시보드가 레벨별 건수를 본문 파싱 없이 센다. 가짓수 셋.
  stage.regex {
    expression = "^\\S+ \\S+ \\[[^\\]]*\\] \\[[^\\]]*\\] (?P<level>[A-Z]+)\\s"
  }
  stage.labels {
    values = { level = "" }
  }
  stage.static_labels {
    values = { app = "3am" }
  }
}

// ── nginx access log: 요청 한 줄 한 줄(봇 스캔, 경로별 호출, UA)을 로키로 ──
// 앱은 요청 단위 로그를 안 찍고 지표로만 센다. "누가 뭘 때렸나"는 여기서만 보인다.
// 상태코드와 메서드만 라벨 — 경로, IP, UA를 라벨로 올리면 가짓수가 폭발한다.
// 그 셋은 조회할 때 pattern 파서로 꺼낸다(deploy/grafana/3am-logs.json 쿼리 참고).
// 읽기 권한: Ubuntu의 nginx 로그는 www-data:adm 640이라 alloy를 adm 그룹에 넣는다
// (sudo usermod -aG adm alloy). logrotate가 새 파일을 같은 권한으로 만들어 ACL보다 안전하다.
local.file_match "nginx_access" {
  path_targets = [{ __path__ = "/var/log/nginx/access.log", job = "nginx-access" }]
}

loki.source.file "nginx" {
  targets    = local.file_match.nginx_access.targets
  forward_to = [loki.process.nginx.receiver]
}

loki.process "nginx" {
  forward_to = [loki.write.grafana_cloud.receiver]

  // combined 형식: ip - user [시각] "METHOD /path HTTP/x" status bytes "referer" "ua"
  // 깨진 요청("-" 400 같은)은 정규식이 안 걸려 라벨 없이 그대로 보낸다.
  stage.regex {
    expression = "^\\S+ \\S+ \\S+ \\[[^\\]]*\\] \"(?P<method>[A-Z]+) [^\"]*\" (?P<status>\\d{3}) "
  }
  stage.labels {
    values = { method = "", status = "" }
  }
  stage.static_labels {
    values = { app = "3am" }
  }
}

// ── nginx error log: nginx와 앱 사이 연결이 왜 실패했는지 ──
// access log는 502/504라는 결과만 남긴다. 거절(connect() failed)인지, 앱이 늦은 것(upstream timed out)인지,
// 앱이 응답 중에 끊은 것(prematurely closed)인지는 여기에만 찍힌다. 권한은 access log와 같다(adm 그룹).
local.file_match "nginx_error" {
  path_targets = [{ __path__ = "/var/log/nginx/error.log", job = "nginx-error" }]
}

loki.source.file "nginx_error" {
  targets    = local.file_match.nginx_error.targets
  forward_to = [loki.process.nginx_error.receiver]
}

loki.process "nginx_error" {
  forward_to = [loki.write.grafana_cloud.receiver]

  // 형식: 2026/11/14 10:00:00 [error] 123#123: *45 메시지, client: ..., request: "...", upstream: "..."
  stage.regex {
    expression = "^\\S+ \\S+ \\[(?P<level>[a-z]+)\\]"
  }
  stage.labels {
    values = { level = "" }
  }
  stage.static_labels {
    values = { app = "3am" }
  }
}

// ── Grafana Cloud로 전송 ─────────────────────────────────────────────────
// 토큰 하나로 지표와 로그 둘 다 민다 — 정책(alloy-write)에 metrics:write + logs:write.
prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = "https://prometheus-prod-49-prod-ap-northeast-0.grafana.net/api/prom/push"

    basic_auth {
      username      = "3423402"            // 스택의 Prometheus 인스턴스 ID
      password_file = "/etc/alloy/token"   // 커밋 금지, 서버에만
    }
  }
}

loki.write "grafana_cloud" {
  endpoint {
    url = "https://logs-prod-030.grafana.net/loki/api/v1/push"

    basic_auth {
      username      = "1707376"            // 스택의 Loki 인스턴스 ID
      password_file = "/etc/alloy/token"
    }
  }
}
